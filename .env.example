# Copy to .env and adjust as needed. Environment variables override config files.

# API listen address.
DDE_HTTP_ADDR=:8080

# PostgreSQL connection string. Leave empty to use the in-memory store (no
# infrastructure required — useful for local dev and the CLI).
# DATABASE_URL=postgres://dde:dde@localhost:5432/dde?sslmode=disable
DATABASE_URL=

# Connection pool size for PostgreSQL.
DDE_DB_MAX_CONNS=10

# Logging: level is debug|info|warn|error, format is json|text.
DDE_LOG_LEVEL=info
DDE_LOG_FORMAT=json

# Reasoning backend: mock (default, deterministic, no API key), a real LLM
# planner (anthropic | openai | deepseek), or multi (a multi-model composition).
DDE_PLANNER=mock

# API keys — set the one matching DDE_PLANNER.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Real LLM planner settings (used when DDE_PLANNER is a real provider).
# Leave DDE_LLM_MODEL empty to use each provider's default
# (anthropic→claude-opus-4-8, openai→gpt-4o, deepseek→deepseek-chat).
DDE_LLM_MODEL=
DDE_LLM_MAX_TOKENS=4096
# Optional: override the OpenAI-compatible endpoint (gateway/self-hosted).
DDE_LLM_BASE_URL=

# Multi-model planner (used when DDE_PLANNER=multi).
#   verify   = providers[0] proposes, providers[1] critiques
#   route    = providers[0] is cheap, providers[1] is strong (escalation)
#   ensemble = all providers run; agreement scales top-move confidence
DDE_MULTI_MODE=verify
# Ordered provider list (>=2). "mock" is allowed for a keyless offline demo, e.g. mock,mock.
DDE_MULTI_PROVIDERS=anthropic,openai
# Router-only: escalate to the strong model below this top-move confidence.
DDE_MULTI_CONFIDENCE_THRESHOLD=0.6
# Router-only: send re-plans (signals) straight to the strong model.
DDE_MULTI_ESCALATE_ON_SIGNAL=true

# Maximum duration for a single HTTP request.
DDE_REQUEST_TIMEOUT=15s

# Comma-separated CORS origins allowed to call the API (the admin UI).
DDE_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Admin UI -> API URL (used by the Next.js app).
NEXT_PUBLIC_DDE_API_URL=http://localhost:8080
NEXT_PUBLIC_GRAFANA_URL=http://localhost:3001
