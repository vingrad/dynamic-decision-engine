# Production secrets/config for the public VPS deployment. Copy to .env.prod and
# fill in. NEVER commit .env.prod (it is gitignored).
#
# Deploy with:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# Public hostname. DNS A/AAAA must point at this VPS and ports 80+443 must be open
# BEFORE the first start, or Caddy can't complete the Let's Encrypt challenge.
DDE_DOMAIN=demo.example.com

# Browser uses same-origin so CORS isn't exercised by it; set this to your domain
# for any direct cross-origin API testers.
DDE_CORS_ALLOWED_ORIGINS=https://demo.example.com

# Public-demo reasoning backend: visitors bring their own LLM key (X-LLM-* headers),
# falling back to the deterministic mock when none is supplied. The operator holds
# no key and pays no LLM cost.
DDE_PLANNER=byok

# Strong Postgres password (the api DATABASE_URL is derived from it in compose).
POSTGRES_PASSWORD=change-me-strong-password

# Grafana admin login (served under https://DDE_DOMAIN/grafana). Never leave default.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-strong-password

# NOTE: NEXT_PUBLIC_DDE_API_URL is intentionally NOT set — the frontend defaults to
# same-origin so one built image works on any host. Only set it to override.
